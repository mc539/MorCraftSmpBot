# Google AI Studio > API keys
GEMINI_API_KEY=put-your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Discord Developer Portal bot token (leave blank until Discord bot is created)
DISCORD_BOT_TOKEN=
# Optional: only answer in this Discord channel. Leave blank to answer in any channel
# where the bot is mentioned or receives !ai.
DISCORD_CHANNEL_ID=

# Exact website origin, e.g. https://mc539.github.io
WEBSITE_ORIGIN=
PORT=3000
WEB_CHAT_PER_MINUTE=8

BOT_SYSTEM_PROMPT=Sen MorCraftSmp sunucusunun Türkçe yardımcı yapay zekâsısın. Samimi ve kısa cevap ver. Bilmediğin sunucu özelliklerini uydurma. Asla coin veya rütbe işlemi yaptığını iddia etme.