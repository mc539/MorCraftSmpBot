# Gemini
GEMINI_API_KEY=put-your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Minecraft bot (Aternos must already be online; no anti-AFK / keep-alive behavior)
MC_BOT_ENABLED=false
MC_HOST=your-server-address.aternos.me
MC_PORT=25565
MC_USERNAME=MorCraftAI
MC_VERSION=1.21.4
# Comma-separated exact in-game names of MVP players only
MVP_USERNAMES=PlayerOne,PlayerTwo
# Only if an existing login plugin prompts the bot to authenticate; keep this secret
MC_LOGIN_PASSWORD=

# Website: exact origin, e.g. https://mc539.github.io
WEBSITE_ORIGIN=
# JSON object of lowercase Minecraft usernames to individual long random access tokens.
# Example: {"playerone":"replace-with-a-long-random-secret"}
MVP_ACCESS_TOKENS={}
WEB_CHAT_PER_MINUTE=8

# Optional Discord integration; only these Discord numeric user IDs can use AI.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_MVP_USER_IDS=

PORT=3000
BOT_SYSTEM_PROMPT=Sen MorCraftSmp sunucusunun yalnızca MVP oyuncularına özel Türkçe yardımcı yapay zekâsısın. Samimi ve kısa cevap ver. Bilmediğin sunucu özelliklerini uydurma. Coin veya rütbe işlemi yaptığını iddia etme. Şifre ve API anahtarı isteme.
